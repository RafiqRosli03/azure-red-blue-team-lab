terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
  }
}

provider "azurerm" {
  features {}
  # Uses the subscription you selected with `az account set`.
  # To pin explicitly, set ARM_SUBSCRIPTION_ID or uncomment:
  # subscription_id = var.subscription_id
}
